{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.r1shop.net/app/v1/bootstrap-response.schema.json",
  "title": "Storefront bootstrap response",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "configuration_version",
        "tenant",
        "branding",
        "regional",
        "channel",
        "features"
      ],
      "properties": {
        "contract_version": { "const": 1 },
        "configuration_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tenant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["public_id", "display_name"],
          "properties": {
            "public_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$" },
            "display_name": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "branding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logo_url", "primary_color", "customer_service_qr_url"],
          "properties": {
            "logo_url": { "type": ["string", "null"], "format": "uri" },
            "primary_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "customer_service_qr_url": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "regional": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locale",
            "enabled_locales",
            "fallback_locale",
            "currency",
            "enabled_currencies",
            "time_zone",
            "direction"
          ],
          "properties": {
            "locale": { "$ref": "#/$defs/locale" },
            "enabled_locales": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/locale" }
            },
            "fallback_locale": { "$ref": "#/$defs/locale" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "enabled_currencies": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
            },
            "time_zone": { "type": "string", "minLength": 1, "maxLength": 64 },
            "direction": { "type": "string", "enum": ["ltr", "rtl"] }
          }
        },
        "channel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "app_id"],
          "properties": {
            "type": { "type": "string", "enum": ["h5", "mp-weixin"] },
            "app_id": { "type": ["string", "null"], "maxLength": 64 }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["popup_enabled"],
          "properties": {
            "popup_enabled": { "type": "boolean" }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  },
  "$defs": {
    "locale": { "type": "string", "enum": ["zh-CN", "en-US"] }
  }
}
